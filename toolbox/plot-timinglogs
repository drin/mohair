# >> Plotting functions

def CreateFigure(input_cfg={}) -> Figure:
    """ Convenience function that creates a matplotlib Figure. """

    default_cfg = {
         'id'    : None
        ,'width' : 24
        ,'height': 8
        ,'dpi'   : 600
    }

    # Take specified config over defaults
    fig_config = dict(default_cfg)
    fig_config.update(input_cfg)

    # use `pyplot.figure` to create the `matplotlib.Figure`
    return pyplot.figure(
         num     =  fig_config['id']
        ,figsize = (fig_config['width'], fig_config['height'])
        ,dpi     =  fig_config['dpi']
    )


def CreatePanelIntervalByQuerySplit( parent_figure
                                    ,panel_intervals
                                    ,bin_dim   =0
                                    ,panel_size=(20.0, 6.0)
                                    ,panel_pos =( 2.0, 1.5)):
    """
    Creates a matplotlib.axes.Axes instance (a "panel") and populates it with N interval
    plots, where N is the number of queries to plot. Each interval plot shows timings for
    each step as it spans the topology. Comparison across interval plots shows how timings
    change across the topology for different query splits.
    """

    # Make sure the figure is activated
    pyplot.figure(parent_figure)

    # Create the `Axes` instance for the panel (percentages of parent dim)
    interval_panel = parent_figure.add_axes([
         panel_pos[0]  / parent_figure.get_figwidth()
        ,panel_pos[1]  / parent_figure.get_figheight()
        ,panel_size[0] / parent_figure.get_figwidth()
        ,panel_size[1] / parent_figure.get_figheight()
    ])

    count_intervals = 0
    latest_stopts   = 0
    prev_stopts     = 0
    for split_intervals in panel_intervals:
        for timing_interval in split_intervals:
            # Move to the next bar position if we have an overlapping interval
            if timing_interval['start'] < prev_stopts: count_intervals += 1

            latest_stopts = max(latest_stopts, timing_interval['stop'])

            prev_stopts = timing_interval['stop']

    # panel_intervals should be a list(list(tuple)). The dimensions are as follows:
    #   1. The elements of the outer list correspond to different query splits
    #   2. The elements of the inner list correspond to each step in chronological order
    #   3. The tuple contains device ID, step name, and latency (microsecs) of the step

    # Calculate count for sub-panels and multiply by how many intervals each will have
    interval_panel.set_xlim(0, count_intervals + 1)

    # Largest stop timestamp
    latest_stopts += 500
    interval_panel.set_ylim(0, latest_stopts)

    interval_panel.tick_params(
        bottom=True , labelbottom=True ,
        left  =True , labelleft  =True ,
        right =False, labelright =False,
        top   =False, labeltop   =False
    )
    interval_panel.set_yticks(
         ticks =[tick_val        for tick_val in range(0, latest_stopts + 1, 5000)]
        ,labels=[f'{tick_val}ms' for tick_val in range(0, latest_stopts + 1, 5000)]
        ,fontsize=8
    )

    # Plotting properties for the intervals themselves
    bar_width = 1
    bar_color = ConvertRGB((120, 172, 145))
    colors_by_step = ColorsForCustomHeatmap(gradient_range=len(indexed_steps))

    # Collection of timings for a particular query split (for a sub-panel)
    interval_ndx    = 0
    prev_stop       = 0

    step_ticks, step_labels, step_colors = [], [], []
    service_label    = None
    split_baseoffset = 0
    for split_intervals in panel_intervals:
        prev_service    = None
        current_service = None

        count_steps = len(split_intervals)

        # List of timings for each step in chronological order (each interval)
        for step_ndx, timing_interval in enumerate(split_intervals):
            # Move to the next bar position if we have an overlapping interval
            if timing_interval['start'] < prev_stop: interval_ndx += 1

            step_name       = timing_interval['step_id']
            current_service = step_name[:3].upper()

            step_color    = colors_by_step[indexed_steps[step_name[4:]]]
            service_color = dev_colors[current_service]

            if timing_interval['duration'] > 400:
                step_ticks.append(interval_ndx + float(bar_width / 2))
                step_labels.append(step_name[4:])
                step_colors.append(step_color)

            if step_ndx == 0:
                service_label = f'{current_service}: Begin Query'

            elif step_ndx == count_steps - 1:
                service_label = f'{current_service}: End Query'

            else:
                service_label = current_service

            # >> Plot the interval itself
            # Plot the whole bar
            interval_panel.add_patch(patches.Rectangle(
                 (interval_ndx, timing_interval['start'])
                ,bar_width
                ,timing_interval['duration']
                ,facecolor='white'
                ,edgecolor=service_color
                ,linewidth=0.5
            ))

            # Plot a fill color for the bar
            if timing_interval['duration'] > 150:
                fill_padding = 50
                interval_panel.add_patch(patches.Rectangle(
                     (interval_ndx, timing_interval['start'] + fill_padding)
                    ,bar_width
                    ,timing_interval['duration'] - fill_padding
                    ,facecolor=step_color
                    ,linewidth=0
                ))

                # Plot a label for service name at the bottom of the bar
                interval_panel.text(
                     interval_ndx + float(bar_width/2)
                    ,(timing_interval['start'] + 60)
                    ,service_label
                    ,ha='center'
                    ,va='bottom'
                    ,rotation=0
                    ,rotation_mode='anchor'
                    ,fontsize=4
                    ,color='white'
                )

            # Plot a label for duration at the top of the bar
            if timing_interval['duration'] > 300:
                vpadding = 150
                interval_panel.text(
                     interval_ndx + float(bar_width/2)
                    ,(timing_interval['start'] + timing_interval['duration'] - vpadding)
                    ,str(int(timing_interval['duration']))
                    ,ha='center'
                    ,va='center'
                    ,rotation=0
                    ,rotation_mode='anchor'
                    ,color='white'
                    ,fontsize=5
                )

            split_baseoffset += 1
            prev_stop         = timing_interval['stop']

    # Set X ticks after we know what they are
    interval_panel.set_xticks(
         ticks =step_ticks
        ,labels=step_labels
        ,rotation=70
        ,rotation_mode='anchor'
        ,ha='right'
        ,fontsize=6
    )

    for ndx, xlabel in enumerate(interval_panel.get_xticklabels()):
        xlabel.set_color(step_colors[ndx % len(step_colors)])

    return interval_panel


