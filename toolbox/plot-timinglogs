                  numpy.strings.endswith(service_intervals['step_id'], 'PhaseParse')
                | numpy.strings.endswith(service_intervals['step_id'], 'PhaseDelegate')
                | numpy.strings.endswith(service_intervals['step_id'], 'PhaseExecute')
                | numpy.strings.endswith(service_intervals['step_id'], 'DuckService')
            )]
        )
    
    # >> Plot figures
    timing_fig = CreateFigure()

    print('Creating interval plot')
    timing_panel_interval = CreatePanelIntervalByQuerySplit(
        timing_fig, step_times_by_query
    )

    pyplot.savefig(parsed_args.output_fpath)

