# >> Helper functions

def NormalizeTimestamps(base_ts, start_ts, stop_ts, len_ts, is_micros=True):
    def micros_to_millis(microsecs): return microsecs / 1000
    # def micros_to_millis(microsecs): return microsecs

    return (
         micros_to_millis(start_ts - base_ts)
        ,micros_to_millis(stop_ts - base_ts)
        ,micros_to_millis(len_ts)
    )


# >> Reader functions

def TimingsFromLog(expected_dev_id, log_fpath):
    """ Parses entries from a **simplified** log file into intervals. """

    trecords = []
    with open(log_fpath) as log_fhandle:
        # Parse initial timestamp
        init_ts_id, init_ts = next(log_fhandle).strip().split(' ')

        # Verify the service ID used in this log (optional, but why not)
        match_dev_id = re.match(r'(CS.*)-', init_ts_id)
        if match_dev_id is None:
            sys.exit(f'Unexpected device prefix used: {init_ts_id}')

        dev_id = match_dev_id.group(1).upper()
        if not expected_dev_id == dev_id:
            sys.exit(f'Expected log file for service [{expected_dev_id}], found {dev_id}')

        # Parse first timing record (to establish base timestamp)
        record_name, start_ts, stop_ts, len_ts = next(log_fhandle).strip().split(' ')
        base_ts = int(start_ts)

        trecords.append(
              (record_name,)
            + NormalizeTimestamps(base_ts, int(start_ts), int(stop_ts), int(len_ts))
        )

        # Normalize and accumulate remaining timing records
        for timing_record in log_fhandle:
            record_name, start_ts, stop_ts, len_ts = timing_record.strip().split(' ')

            # NOTE: for now we strip the service name prefix
            # Normalize and accumulate the timings
            trecords.append(
                  (record_name,)
                + NormalizeTimestamps(base_ts, int(start_ts), int(stop_ts), int(len_ts))
            )

    # Schema of timing records
    record_fields = [
         ('step_id' , '<U38'       )
        ,('start'   , numpy.int64 )
        ,('stop'    , numpy.int64 )
        ,('duration', numpy.float64)
    ]

    #pdb.set_trace()

    return numpy.array(trecords, dtype=record_fields)


# >> Processing functions (preprocessing for plotting)

def CoalesceTimingsByQuery(timings_by_service):
    """
    Reorganize timing data in from a service-oriented structure to a query-oriented
    structure.
    NOTE: this may not be necessary if we propagate timing data with a query.
    """

    # NOTE: for now, we assume :timings_by_service: is in topological order by service

    # Gather start and stop timestamps for each service by query
    tsbounds_by_query = []
    for ws_service in timings_by_service:
        is_parsephase = numpy.strings.endswith(
            ws_service['step_id'], 'ServicePhaseParse'
        )

        is_execphase = numpy.strings.endswith(
            ws_service['step_id'], 'ServicePhaseExecute'
        )

        ws_parsephase = ws_service[is_parsephase]
        ws_execphase  = ws_service[is_execphase]

        tsbounds_by_query.append(
            numpy.column_stack(
                (ws_parsephase['start'], ws_execphase['stop'])
            )
        )

    count_queries      = len(tsbounds_by_query[0])
    intervals_by_query = []
    for ndx_query in range(count_queries):
        ws_query = None

        for ndx_service, ws_service in enumerate(timings_by_service):
            ts_qstart, ts_qstop = tsbounds_by_query[ndx_service][ndx_query, :]
            ws_servicequery = ws_service[
                  (ws_service['start'] >= ts_qstart)
                & (ws_service['stop']  <= ts_qstop)
            ]

            # Normalize the service timings to relative to start of the query
            ws_servicequery = ws_servicequery.copy()
            ws_servicequery['start'] -= ts_qstart
            ws_servicequery['stop']  -= ts_qstart

            # First service initializes the accumulated records
            if ndx_service == 0:
                ws_query = ws_servicequery
                continue

            # NOTE: this only works for linear topology
            # Otherwise, the downstream service timestamps go before "DelegateSubplan"
            is_delegatestep = numpy.strings.endswith(
                ws_query['step_id'], 'ActionServiceSendPushdown'
            )
            rowndx_pushdowns = numpy.where(is_delegatestep)
            query_mergerow   = rowndx_pushdowns[0][0]

            # For consistency (and readability), shift this service's timestamps
            ts_shift       = ws_query[query_mergerow]['start']
            ws_servicequery['start'] += ts_shift
            ws_servicequery['stop']  += ts_shift

            # Do the actual merge of timing records
            ws_query = numpy.hstack([
                 ws_query[:query_mergerow]
                ,ws_servicequery
                ,ws_query[query_mergerow:]
            ])

        intervals_by_query.append(ws_query)

        # TODO: for now, just test on first and second queries
        # if ndx_query >= 1: break

    return intervals_by_query


# >> Plotting helper functions

# Colors
def ConvertRGB(rgb_tuple):
    """
    Converts a tuple of ints (RGB values) to a tuple of floats (range: [0, 1]).
    """

    return tuple(val / 255 for val in rgb_tuple)


def ColorsForGradient(rgb_list, sample_size=100):
    """
    Returns a gradient for a list of RGB points by constructing gradients between each
    pair of RGB points and combining them together (using list.extend).
    """

    def PairwiseGradient(rgb_start, rgb_end, gradient_len):
        """ Closure for generating a gradient between 2 RGB points. """

        # create linear spaces as a column-based list of RGB values
        gradient_dims = [
            numpy.linspace(rgb_start[color_dim], rgb_end[color_dim], gradient_len)
            for color_dim in range(3)
        ]

        # transforms column-based to row-based
        return [
            tuple((
                 gradient_dims[0][color_ndx]
                ,gradient_dims[1][color_ndx]
                ,gradient_dims[2][color_ndx]
            ))
            for color_ndx in range(gradient_len)
        ]

    # number of gradients (intervals between RGB points)
    gradient_count = len(rgb_list) - 1
    gradient_len   = int(sample_size / gradient_count) + 1

    # for each gradient interval
    gradient_colors = []
    for rgb_ndx in range(gradient_count):
        gradient_colors.extend(PairwiseGradient(
             rgb_list[rgb_ndx]
            ,rgb_list[rgb_ndx + 1]
            ,gradient_len
        ))

    return gradient_colors


